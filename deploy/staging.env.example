# ============================================================================
# .env de referencia para STAGING (docker-compose.prod.yml en el servidor)
# ============================================================================
# Copiar a /opt/sgsst/.env en la VM, reemplazar los valores entre <...> y
# NUNCA versionar el archivo real. Los secretos salen del gestor de secretos.
# Validar antes de arrancar: docker compose -f docker-compose.prod.yml config
#
# Puertos: API y web publican SOLO en 127.0.0.1 (bind loopback); Caddy
# (deploy/caddy/Caddyfile) termina TLS y es la unica puerta 80/443.

# --- Imagenes (obligatorias) ---
# Dueno del repo en GitHub (GHCR).
GHCR_OWNER=Byneros
# Etiqueta inmutable del release: sha-<commit> (git rev-parse HEAD del release).
# NUNCA usar latest como referencia de despliegue.
IMAGE_TAG=sha-<commit-del-release>

# --- Base de datos (obligatoria) ---
POSTGRES_PASSWORD=<secreto-largo-unico>
POSTGRES_DB=sgsst
# El compose publica Postgres SIN puerto al host: solo red interna de Docker.
# Para el job `migrate` de GitHub Actions ver docs/despliegue-preparacion.md.

# --- Seguridad (obligatorias) ---
# Minimo 32 caracteres, unico por ambiente.
JWT_SECRET=<secreto-largo-min-32>
# Token del endpoint /api/v1/metrics; igual al secreto METRICS_TOKEN del
# ambiente GitHub para que el smoke test funcione.
METRICS_TOKEN=<secreto-largo-min-32>

# --- URLs (obligatorias; TLS termina en Caddy) ---
# Hostnames que resuelven a la IP publica de la VM (dominio propio o
# sslip.io/nip.io, p. ej. app.203.0.113.10.sslip.io / api.203.0.113.10.sslip.io).
CORS_ORIGINS=https://app.<host-staging>
PUBLIC_BASE_URL=https://api.<host-staging>
WEB_BASE_URL=https://app.<host-staging>

# --- Puertos (solo loopback; Caddy reenvia) ---
# Por defecto el compose publica API en 127.0.0.1:3001 y web en 127.0.0.1:8080
# (bind loopback, no accesibles desde Internet). Sobrescribir solo si el
# proveedor usa un balanceador privado que necesite otro bind (p. ej. 0.0.0.0).
# API_HOST_PORT=127.0.0.1
# WEB_HOST_PORT=127.0.0.1

# --- Sesion ---
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Infra interna ---
REDIS_URL=redis://redis:6379

# --- Storage de documentos ---
# `local` usa el volumen document_uploads; cambiar a `s3` requiere las vars S3_*.
DOCUMENT_STORAGE_DRIVER=local

# --- Backup cifrado (perfil backup; recomendado activarlo tras verificar TLS) ---
BACKUP_ENCRYPTION_PUBLIC_KEY=
BACKUP_ALERT_EMAIL_ENABLED=false
BACKUP_ALERT_EMAIL_TO=
BACKUP_RESTORE_CHECK_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Subida a S3-compatible (MinIO, Backblaze B2, etc.). Vacio = backup solo local.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
