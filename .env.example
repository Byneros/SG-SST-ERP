POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sgsst
# Host-port del Postgres dev; subelo si un servicio PostgreSQL de Windows ocupa el mismo puerto (ver docs/convivencia-dev-prod-local.md)
POSTGRES_HOST_PORT=5433
API_PORT=3001
WEB_PORT=5176
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=30
# REDIS_URL: no definir aqui; compose usa redis://redis:6379 por defecto.
# Para correr la API fuera de Docker, usar sgsst-api/.env (localhost).
CORS_ORIGINS=http://localhost:5176
VITE_API_URL=http://localhost:3001/api/v1
PUBLIC_BASE_URL=http://localhost:3001
UPLOADS_PATH=uploads
DOCUMENT_STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
METRICS_TOKEN=change-me-with-a-unique-metrics-token
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
DASHBOARD_CACHE_TTL_SECONDS=30
NOTIFICATIONS_QUEUE_ENABLED=true
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_CRON=0 7 * * *
REPORTS_QUEUE_ENABLED=true
REPORTS_WORKER_ENABLED=true
REPORTS_CLEANUP_CRON=0 3 * * *
REPORTS_METRICS_CRON=30 3 * * *
REPORTS_ALERTS_CRON=0 4 * * *
REPORT_ALERTS_ENABLED=true
REPORT_FAILURE_RATE_ALERT_PERCENT=20
REPORT_STORAGE_ALERT_BYTES=1073741824
REPORT_EXPORT_EXPIRATION_DAYS=7
REPORT_EXPORT_RETENTION_DAYS=7
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
EXTERNAL_DELIVERY_RETRY_CRON=*/10 * * * *
EXTERNAL_DELIVERY_MAX_ATTEMPTS=3
EXTERNAL_DELIVERY_RETRY_BASE_SECONDS=300
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_STALENESS_HOURS=24
# Cifrado de backups en reposo (age): clave publica del destinatario.
# Generar: age-keygen | age-keygen -y
BACKUP_ENCRYPTION_PUBLIC_KEY=
# Sincronizacion externa del backup (S3-compatible: S3, MinIO, GCS, Azure).
# Vacio = solo local. Fallback automatico a S3_* si se dejan vacios.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
# Asistente IA (Sprint 16): proveedor OpenAI-compatible; solo backend
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Contrasena del seed (admin@sgsst.com, sst@sgsst.com, empleado@sgsst.com).
# Solo se usa al correr `npm run seed`. En produccion `assertProductionEnv`
# rechaza el arranque si queda la contrasena publica por defecto (H-4).
SEED_ADMIN_PASSWORD=
