  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LegalNormStatus {
  ACTIVE
  INACTIVE
  SUPERSEDED
}

enum LegalObligationFrequency {
  ONCE
  ANNUAL
  SEMIANNUAL
  QUARTERLY
  MONTHLY
  EVENT_BASED
  CONTINUOUS
}

enum LegalRequirementStatus {
  PENDING
  COMPLIES
  PARTIAL
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum IncidentStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum CompanyRiskClass {
  CLASS_I
  CLASS_II
  CLASS_III
  CLASS_IV
  CLASS_V
}

enum DocumentType {
  CC
  CE
  TI
  PASSPORT
  NIT
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  SERVICE
  APPRENTICESHIP
  TEMPORARY
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RETIRED
}

enum DocumentCategory {
  POLICY
  PROCEDURE
  CERTIFICATE
  TRAINING_EVIDENCE
  INCIDENT_EVIDENCE
  AUDIT_EVIDENCE
  MEDICAL
  OTHER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NotificationType {
  INFO
  DOCUMENT_EXPIRING
  TRAINING_OVERDUE
  INCIDENT_OPEN
  TASK
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExternalDeliveryProvider {
  WHATSAPP
  EMAIL
  TEAMS
  SLACK
}

enum ExternalDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum EvaluationStatus {
  IN_PROGRESS
  COMPLETED
}

enum EvaluationItemStatus {
  PENDING
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  NOT_APPLICABLE
}

model SsoProvider {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  // OIDC | SAML: una fila usa los campos de su protocolo.
  protocol              String   @default("OIDC")
  issuer                String
  clientId              String
  clientSecret          String
  authorizationEndpoint String
  tokenEndpoint         String
  userinfoEndpoint      String?
  scopes                String   @default("openid email profile")
  defaultRole           Role     @default(EMPLOYEE)
  jwksUri               String?
  // SAML: metadata del IdP o triple entity/sso-url/cert; config SP del backend.
  idpMetadata           String?
  idpEntityId           String?
  idpSsoUrl             String?
  idpCertificate        String?
  spEntityId            String?
  // Overrides de rol por grupo del IdP: { "grupo": "SST", ... }. Los demas
  // usuarios entran con defaultRole.
  roleGroups            Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id])

  @@index([issuer])
  @@index([protocol])
}

model SsoState {
  id        String   @id
  companyId String
  redirect  String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}
