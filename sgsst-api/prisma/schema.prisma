generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String
  role                   Role      @default(EMPLOYEE)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  companyId              String?
  isActive               Boolean   @default(true)
  deletedAt              DateTime?
  refreshTokenHash       String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  mfaSecret              String?
  mfaEnabled             Boolean   @default(false)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  ssoSubject             String?   @unique

  auditLogs                       AuditLog[]
  notifications                   Notification[]
  reportExports                   ReportExport[]
  approvedAnnualWorkPlans         AnnualWorkPlan[]      @relation("AnnualWorkPlanApprover")
  ownedAnnualPlanActivities       AnnualPlanActivity[]  @relation("AnnualPlanActivityOwner")
  medicalSurveillanceProgramsOwned MedicalSurveillanceProgram[] @relation("MedicalSurveillanceOwner")
  plannedInspectionsAsInspector   PlannedInspection[]   @relation("PlannedInspectionInspector")
  unplannedInspectionsAsInspector UnplannedInspection[] @relation("UnplannedInspectionInspector")
  unsafeReportsAsReporter         UnsafeReport[]        @relation("UnsafeReportReporter")
  company                         Company?              @relation(fields: [companyId], references: [id])

  @@index([lockedUntil])
}

model Company {
  id                            String                       @id @default(uuid())
  name                          String
  nit                           String                       @unique
  address                       String?
  phone                         String?
  email                         String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  isActive                      Boolean                      @default(true)
  deletedAt                     DateTime?
  arl                           String?
  riskClass                     CompanyRiskClass             @default(CLASS_I)
  economicActivity              String?
  city                          String?
  department                    String?
  reportExportExpirationDays    Int?
  reportExportRetentionDays     Int?
  reportFailureRateAlertPercent Int?
  reportStorageAlertBytes       Int?
  whatsappAlertsEnabled         Boolean                      @default(false)
  whatsappAlertPhone            String?
  ssoProvider                   SsoProvider?
  audits                        Audit[]
  legalRequirements             CompanyLegalRequirement[]
  documents                     Document[]
  employees                     Employee[]
  externalDeliveries            ExternalDelivery[]
  incidents                     Incident[]
  indicators                    Indicator[]
  legalComplianceReviews        LegalComplianceReview[]
  notifications                 Notification[]
  reportExports                 ReportExport[]
  annualWorkPlans               AnnualWorkPlan[]
  plannedInspections            PlannedInspection[]
  unsafeReports                 UnsafeReport[]
  ppeItems                      PpeItem[]
  ppeDeliveries                 PpeDelivery[]
  medicalExams                  MedicalExam[]
  medicalRestrictions           MedicalRestriction[]
  medicalProfiles               MedicalProfile[]
  medicalSurveillancePrograms   MedicalSurveillanceProgram[]
  medicalCohorts                MedicalSurveillanceCohort[]
  auditPrograms                 AuditProgram[]
  sgsstEvaluations              SgsstEvaluation[]
  reportMetricSnapshots         ReportExportMetricSnapshot[]
  risks                         Risk[]
  sites                         Site[]
  trainings                     Training[]
  users                         User[]
  annualPlanActivities          AnnualPlanActivity[]
  unplannedInspections          UnplannedInspection[]
  contractors                   Contractor[]
  contractorWorkers             ContractorWorker[]
  contractorDocuments           ContractorDocument[]
}

model Site {
  id                   String                @id @default(uuid())
  name                 String
  code                 String?
  address              String?
  city                 String?
  department           String?
  isMain               Boolean               @default(false)
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  employees            Employee[]
  risks                Risk[]
  incidents            Incident[]
  trainings            Training[]
  documents            Document[]
  plannedInspections   PlannedInspection[]
  unplannedInspections UnplannedInspection[]
  unsafeReports        UnsafeReport[]
  indicators           Indicator[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(true)
  deletedAt            DateTime?

  @@index([companyId, code])
  @@index([companyId, isActive])
}

model Employee {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  document            String               @unique
  position            String
  email               String?
  phone               String?
  createdAt           DateTime             @default(now())
  companyId           String
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  updatedAt           DateTime             @updatedAt
  documentType        DocumentType         @default(CC)
  workCenter          String?
  contractType        ContractType         @default(INDEFINITE)
  employmentStatus    EmploymentStatus     @default(ACTIVE)
  hireDate            DateTime?
  siteId              String?
  company             Company              @relation(fields: [companyId], references: [id])
  site                Site?                @relation(fields: [siteId], references: [id])
  ppeDeliveries       PpeDelivery[]
  medicalExams        MedicalExam[]
  medicalRestrictions MedicalRestriction[]
  surveillanceCohorts MedicalSurveillanceCohort[]
}

model Risk {
  id                 String              @id @default(uuid())
  title              String
  description        String?
  level              RiskLevel
  createdAt          DateTime            @default(now())
  companyId          String
  siteId             String?
  company            Company             @relation(fields: [companyId], references: [id])
  site               Site?               @relation(fields: [siteId], references: [id])
  inspectionFindings InspectionFinding[]
  /// Cargo asociado (profesiograma S10.1): habilita la derivacion de
  /// requisitos medicos desde los riesgos del cargo (#25).
  position           String?
  profilesForRisk    MedicalProfile[]            @relation("MedicalProfileCargoRisk")
  cohortsForRisk     MedicalSurveillanceCohort[] @relation("MedicalSurveillanceCohortRisk")
  requirementsDerived MedicalExamRequirement[]   @relation("MedicalRequirementOrigin")

  @@index([companyId, position])
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  description String
  date        DateTime
  status      IncidentStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  companyId   String
  siteId      String?
  company     Company        @relation(fields: [companyId], references: [id])
  site        Site?          @relation(fields: [siteId], references: [id])
}

model Training {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  companyId   String
  siteId      String?
  company     Company  @relation(fields: [companyId], references: [id])
  site        Site?    @relation(fields: [siteId], references: [id])
}

model Audit {
  id                String               @id @default(uuid())
  title             String
  description       String?
  scheduledAt       DateTime
  result            String?
  createdAt         DateTime             @default(now())
  companyId         String
  status            AuditStatus          @default(PLANNED)
  scope             String?
  auditorName       String?
  closedAt          DateTime?
  updatedAt         DateTime             @updatedAt
  programId         String?
  program           AuditProgram?        @relation(fields: [programId], references: [id])
  checklistTemplate Json?
  company           Company              @relation(fields: [companyId], references: [id])
  findings          AuditFinding[]
  checklist         AuditChecklistItem[]
}

model AuditProgram {
  id        String   @id @default(uuid())
  name      String
  period    String
  objective String?
  scope     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  audits    Audit[]
}

model AuditChecklistItem {
  id          String   @id @default(uuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  section     String?
  question    String
  answer      String?
  notes       String?
  responsible String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([auditId])
}

// Plan Anual de Trabajo SG-SST (S8.1): un plan por empresa y anio.
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model AnnualWorkPlan {
  id           String               @id @default(uuid())
  year         Int
  status       String               @default("DRAFT")
  notes        String?
  approvedById String?
  approvedBy   User?                @relation("AnnualWorkPlanApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  activities   AnnualPlanActivity[]

  @@unique([companyId, year])
  @@index([companyId, status])
}

// Actividad del Plan Anual de Trabajo (S8.2): responsable, fecha, evidencia
// documental y % de avance. La evidencia se integra con documents via FK.
model AnnualPlanActivity {
  id         String         @id @default(uuid())
  cycle      String         @default("ACT")
  name       String
  frequency  String?
  dueDate    DateTime?
  progress   Int            @default(0)
  status     String         @default("PENDING")
  budget     Float?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  planId     String
  plan       AnnualWorkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  ownerId    String?
  owner      User?          @relation("AnnualPlanActivityOwner", fields: [ownerId], references: [id])
  evidenceId String?
  evidence   Document?      @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([companyId, status])
}

// Contratistas (S11): empresas contratistas, personal y documentos requeridos.
// Regla de negocio: no se autoriza ingreso con documentos vencidos/rechazados
// o contratista no activo (responsabilidad solidaria). Evidencia documental se
// integra con documents via FK (mismo patron de AnnualPlanActivity.evidence).
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model Contractor {
  id        String               @id @default(uuid())
  name      String
  nit       String
  contact   String?
  phone     String?
  arl       String?
  activity  String?
  status    ContractorStatus     @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  workers   ContractorWorker[]
  documents ContractorDocument[]

  @@unique([companyId, nit])
  @@index([companyId, status])
}

model ContractorWorker {
  id           String                 @id @default(uuid())
  document     String
  firstName    String
  lastName     String
  job          String?
  inductedAt   DateTime?
  status       ContractorWorkerStatus @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contractorId String
  contractor   Contractor             @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company                @relation(fields: [companyId], references: [id])

  @@unique([contractorId, document])
  @@index([companyId])
}

model ContractorDocument {
  id           String                   @id @default(uuid())
  documentType String
  description  String?
  expiresAt    DateTime?
  status       ContractorDocumentStatus @default(PENDING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  contractorId String
  contractor   Contractor               @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  evidenceId   String?
  evidence     Document?                @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])

  @@index([contractorId])
  @@index([companyId, status])
}

enum ContractorStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ContractorWorkerStatus {
  ACTIVE
  INACTIVE
}

enum ContractorDocumentStatus {
  PENDING
  VALID
  EXPIRED
  REJECTED
}

// Inspecciones planeadas (S9.1): programacion por sede, checklist de items y
// hallazgos. Los hallazgos generan acciones correctivas (CorrectiveAction via
// InspectionFinding, mismo patron de Audit -> AuditFinding -> CorrectiveAction).
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model PlannedInspection {
  id                   String                @id @default(uuid())
  title                String
  type                 String                @default("LOCATIVE")
  frequency            String?
  scheduledAt          DateTime
  executedAt           DateTime?
  result               String?
  status               InspectionStatus      @default(PLANNED)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  siteId               String?
  site                 Site?                 @relation(fields: [siteId], references: [id])
  inspectorId          String?
  inspector            User?                 @relation("PlannedInspectionInspector", fields: [inspectorId], references: [id])
  items                InspectionItem[]
  findings             InspectionFinding[]
  unplannedInspections UnplannedInspection[]

  @@index([companyId, status])
  @@index([siteId])
}

// Item del checklist de la inspeccion (respuesta por pregunta).
model InspectionItem {
  id           String            @id @default(uuid())
  order        Int               @default(0)
  section      String?
  question     String
  answer       String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  inspectionId String
  inspection   PlannedInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// Hallazgo de inspeccion con enlace a CorrectiveAction (accion correctiva).
model InspectionFinding {
  id                    String               @id @default(uuid())
  description           String
  severity              FindingSeverity      @default(MINOR)
  status                FindingStatus        @default(OPEN)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Padre opcional: un hallazgo puede venir de una inspeccion planeada,
  // de una no planeada o de un reporte directo (S9.2/S9.3).
  inspectionId          String?
  inspection            PlannedInspection?   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  unplannedInspectionId String?
  unplannedInspection   UnplannedInspection? @relation(fields: [unplannedInspectionId], references: [id], onDelete: Cascade)
  riskId                String?
  risk                  Risk?                @relation(fields: [riskId], references: [id], onDelete: SetNull)
  actionId              String?              @unique
  action                CorrectiveAction?    @relation("InspectionFindingAction", fields: [actionId], references: [id], onDelete: SetNull)
  unsafeReport          UnsafeReport?        @relation(fields: [unsafeReportId], references: [id], onDelete: Cascade)
  unsafeReportId        String?

  @@index([inspectionId])
  @@index([unplannedInspectionId])
  @@index([unsafeReportId])
}

// Inspecciones no planeadas (S9.2): reactivas, con motivo obligatorio.
// Los hallazgos reutilizan InspectionFinding y pueden generar un riesgo en
// la matriz GTC-45 (Risk) ademas de la accion correctiva.
// Actos y condiciones inseguras (S9.3): canal de reporte directo con
// clasificacion (acto de comportamiento / condicion fisica), seguimiento y
// acciones via InspectionFinding (reporte directo, sin inspeccion padre).
// Reportes anonimos: reporterName opcional, nunca se expone al EMPLOYEE.
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model UnsafeReport {
  id           String              @id @default(uuid())
  kind         String              @default("UNSAFE_CONDITION")
  description  String
  severity     FindingSeverity     @default(MINOR)
  status       String              @default("OPEN")
  area         String?
  isAnonymous  Boolean             @default(false)
  reporterName String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  closedAt     DateTime?
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  siteId       String?
  site         Site?               @relation(fields: [siteId], references: [id])
  reporterId   String?
  reporter     User?               @relation("UnsafeReportReporter", fields: [reporterId], references: [id])
  findings     InspectionFinding[]

  @@index([companyId, status])
  @@index([kind])
}

// Catalogo EPP (S9.4): tipo, talla/estandar, vida util y stock minimo.
model PpeItem {
  id             String        @id @default(uuid())
  name           String
  type           String?
  standard       String?
  size           String?
  usefulLifeDays Int?
  stockMin       Int           @default(0)
  stock          Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  deliveries     PpeDelivery[]

  @@index([companyId, isActive])
}

// Entrega de EPP a un trabajador: descuenta stock y programa reposicion.
model PpeDelivery {
  id               String    @id @default(uuid())
  quantity         Int       @default(1)
  deliveredAt      DateTime  @default(now())
  dueReplacementAt DateTime?
  signature        String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  itemId           String
  item             PpeItem   @relation(fields: [itemId], references: [id])
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])

  @@index([employeeId])
  @@index([itemId])
}

// Medicina laboral (S10): profesiograma (requisitos medicos por cargo),
// examenes ocupacionales y restricciones. Datos sensibles: acceso restringido
// a ADMIN/SST/AUDITOR (nunca EMPLOYEE) y solo concepto ocupacional, sin
// historia clinica. Auditoria completa en cada mutacion.

// Profesiograma: perfil medico por cargo con requisitos y periodicidad.
model MedicalProfile {
  id           String                   @id @default(uuid())
  position     String
  description  String?
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])
  requirements MedicalExamRequirement[]
  /// Link al riesgo del cargo en la matriz GTC-45 (#25.2).
  risk         Risk?                    @relation("MedicalProfileCargoRisk", fields: [riskId], references: [id], onDelete: SetNull)
  riskId       String?

  @@unique([companyId, position])
  @@index([companyId, riskId])
}

// Requisito medico del profesiograma: tipo de examen y periodicidad.
model MedicalExamRequirement {
  id                String         @id @default(uuid())
  examType          String
  periodicityMonths Int            @default(12)
  profileId         String
  profile           MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Origen de la derivacion (#25.2): riesgo que exige el examen. SetNull
  /// para que borrar el riesgo no borre el requisito ya aprobado.
  derivedFromRiskId String?
  derivedFromRisk   Risk?          @relation("MedicalRequirementOrigin", fields: [derivedFromRiskId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([derivedFromRiskId])
}

model MedicalSurveillanceProgram {
  id          String   @id @default(uuid())
  name        String
  riskType    String
  objective   String?
  status      String   @default("ACTIVE")
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  owner       User?    @relation("MedicalSurveillanceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  cohorts     MedicalSurveillanceCohort[]

  @@index([companyId, status])
}

model MedicalSurveillanceCohort {
  id               String   @id @default(uuid())
  programId        String
  program          MedicalSurveillanceProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  riskId           String?
  risk             Risk?    @relation("MedicalSurveillanceCohortRisk", fields: [riskId], references: [id], onDelete: SetNull)
  derivedAt        DateTime @default(now())
  lastReviewedAt   DateTime?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  workers          Employee[]

  @@unique([programId, riskId])
  @@index([companyId, status])
  @@index([riskId])
}

// Examen ocupacional de un trabajador: solo concepto operativo (APT0/RESTRICCION/
// NO_APTO), proveedor, proxima fecha; sin diagnostico ni historia clinica.
model MedicalExam {
  id           String               @id @default(uuid())
  examType     String
  concept      String               @default("PENDIENTE")
  scheduledAt  DateTime
  performedAt  DateTime?
  provider     String?
  nextDueAt    DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  restrictions MedicalRestriction[]

  @@index([employeeId])
  @@index([companyId, nextDueAt])
}

// Restriccion laboral derivada de un examen: vigencia y levantamiento.
model MedicalRestriction {
  id          String       @id @default(uuid())
  description String
  startDate   DateTime     @default(now())
  endDate     DateTime?
  liftedAt    DateTime?
  liftedBy    String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  examId      String?
  exam        MedicalExam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])

  @@index([employeeId, status])
}

model UnplannedInspection {
  id                  String              @id @default(uuid())
  title               String
  reason              String
  area                String?
  status              InspectionStatus    @default(PLANNED)
  executedAt          DateTime?
  result              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  siteId              String?
  site                Site?               @relation(fields: [siteId], references: [id])
  inspectorId         String?
  inspector           User?               @relation("UnplannedInspectionInspector", fields: [inspectorId], references: [id])
  findings            InspectionFinding[]
  plannedInspection   PlannedInspection?  @relation(fields: [plannedInspectionId], references: [id])
  plannedInspectionId String?

  @@index([companyId, status])
  @@index([siteId])
}

model SgsstEvaluation {
  id                String           @id @default(uuid())
  name              String
  standard          String           @default("RES_0312_2019")
  riskClass         String
  period            String?
  status            EvaluationStatus @default(IN_PROGRESS)
  score             Float?
  maxScore          Float?
  compliancePercent Float?
  notes             String?
  companyId         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id])
  items             EvaluationItem[]
}

model EvaluationItem {
  id           String               @id @default(uuid())
  evaluationId String
  evaluation   SgsstEvaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  numeral      String?
  section      String?
  question     String
  maxScore     Float                @default(0)
  score        Float?
  status       EvaluationItemStatus @default(PENDING)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([evaluationId])
}

model AuditFinding {
  id          String             @id @default(uuid())
  title       String
  description String?
  severity    FindingSeverity    @default(MINOR)
  status      FindingStatus      @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  auditId     String
  audit       Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actions     CorrectiveAction[]
}

model CorrectiveAction {
  id                  String                 @id @default(uuid())
  title               String
  description         String?
  responsible         String
  dueDate             DateTime
  status              CorrectiveActionStatus @default(PENDING)
  closedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  // Padre opcional: una accion nace de un hallazgo de auditoria (via
  // findingId) o de inspeccion/reporte (via inspectionFindingId, SetNull).
  // Nota: coexisten las columnas inspectionFindingId (escritura en creates de
  // S9) y InspectionFinding.actionId (lectura de idempotencia); ver
  // 20260925190000_s9_corrective_action_link.
  findingId           String?
  finding             AuditFinding?          @relation(fields: [findingId], references: [id], onDelete: Cascade)
  inspectionFindingId String?                @unique
  inspectionFinding   InspectionFinding?     @relation("InspectionFindingAction")
}

model Document {
  id                   String               @id @default(uuid())
  name                 String
  fileUrl              String
  createdAt            DateTime             @default(now())
  companyId            String
  description          String?
  category             DocumentCategory     @default(OTHER)
  status               DocumentStatus       @default(DRAFT)
  fileName             String?
  mimeType             String?
  version              Int                  @default(1)
  expiresAt            DateTime?
  updatedAt            DateTime             @updatedAt
  company              Company              @relation(fields: [companyId], references: [id])
  siteId               String?
  site                 Site?                @relation(fields: [siteId], references: [id])
  versions             DocumentVersion[]
  annualPlanActivities AnnualPlanActivity[]
  contractorDocuments  ContractorDocument[]
}

model DocumentVersion {
  id         String   @id @default(uuid())
  version    Int
  fileUrl    String
  fileName   String?
  mimeType   String?
  notes      String?
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Indicator {
  id                String                 @id @default(uuid())
  name              String
  code              String?
  description       String?
  unit              String?
  value             Float
  formulaDefinition String?
  direction         String                 @default("LOWER_IS_BETTER")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  companyId         String
  siteId            String?
  company           Company                @relation(fields: [companyId], references: [id])
  site              Site?                  @relation(fields: [siteId], references: [id])
  targets           IndicatorTarget[]
  measurements      IndicatorMeasurement[]

  @@unique([companyId, code])
}

model IndicatorTarget {
  id          String    @id @default(uuid())
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      String
  target      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([indicatorId, period])
  @@index([indicatorId])
}

model IndicatorMeasurement {
  id          String    @id @default(uuid())
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      String
  value       Float
  measuredAt  DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([indicatorId, period])
  @@index([indicatorId])
}

model Notification {
  id                 String               @id @default(uuid())
  title              String
  message            String
  read               Boolean              @default(false)
  createdAt          DateTime             @default(now())
  userId             String
  type               NotificationType     @default(INFO)
  priority           NotificationPriority @default(MEDIUM)
  entity             String?
  entityId           String?
  readAt             DateTime?
  companyId          String?
  externalDeliveries ExternalDelivery[]
  company            Company?             @relation(fields: [companyId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
}

model ExternalDelivery {
  id             String                   @id @default(uuid())
  provider       ExternalDeliveryProvider
  status         ExternalDeliveryStatus   @default(PENDING)
  target         String?
  subject        String?
  payload        Json?
  response       Json?
  error          String?
  entity         String?
  entityId       String?
  attemptedAt    DateTime                 @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  companyId      String?
  notificationId String?
  attemptCount   Int                      @default(0)
  maxAttempts    Int                      @default(3)
  nextAttemptAt  DateTime?
  company        Company?                 @relation(fields: [companyId], references: [id])
  notification   Notification?            @relation(fields: [notificationId], references: [id])

  @@index([provider, status, attemptedAt])
  @@index([status, nextAttemptAt])
  @@index([companyId, attemptedAt])
  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
}

model ReportExport {
  id                 String             @id @default(uuid())
  kind               String
  format             String
  status             ReportExportStatus @default(QUEUED)
  requestedCompanyId String?
  fileUrl            String?
  fileName           String?
  mimeType           String?
  storageKey         String?
  size               Int?
  jobId              String?
  error              String?
  requestedAt        DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  requestedById      String
  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id])
  requestedBy        User               @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([companyId, createdAt])
  @@index([status, expiresAt])
}

model ReportExportMetricSnapshot {
  id                       String   @id @default(uuid())
  date                     DateTime
  scopeKey                 String
  total                    Int      @default(0)
  queued                   Int      @default(0)
  processing               Int      @default(0)
  ready                    Int      @default(0)
  failed                   Int      @default(0)
  expired                  Int      @default(0)
  storageBytes             Int      @default(0)
  averageGenerationSeconds Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  companyId                String?
  company                  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([date, scopeKey])
  @@index([companyId, date])
}

model LegalNorm {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  type          String
  issuingEntity String?
  issuedAt      DateTime?
  effectiveFrom DateTime?
  status        LegalNormStatus    @default(ACTIVE)
  url           String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  requirements  LegalRequirement[]
}

model LegalRequirement {
  id                   String                     @id @default(uuid())
  article              String?
  numeral              String?
  title                String
  description          String
  obligationType       String?
  frequency            LegalObligationFrequency   @default(ANNUAL)
  appliesTo            String?
  riskLevel            RiskLevel                  @default(MEDIUM)
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  normId               String
  companyRequirements  CompanyLegalRequirement[]
  evidenceRequirements LegalEvidenceRequirement[]
  norm                 LegalNorm                  @relation(fields: [normId], references: [id], onDelete: Cascade)
  mappings             LegalRequirementMapping[]

  @@index([normId])
  @@index([active, riskLevel])
}

model CompanyLegalRequirement {
  id             String                 @id @default(uuid())
  applies        Boolean                @default(true)
  status         LegalRequirementStatus @default(PENDING)
  ownerId        String?
  dueDate        DateTime?
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  score          Int?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  companyId      String
  requirementId  String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirement    LegalRequirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  evidences      LegalEvidenceLink[]

  @@unique([companyId, requirementId])
  @@index([companyId, status])
  @@index([dueDate])
}

model LegalRequirementMapping {
  id            String           @id @default(uuid())
  moduleKey     String
  entityName    String?
  entityId      String?
  evidenceType  String?
  kpiKey        String?
  reportKey     String?
  createdAt     DateTime         @default(now())
  requirementId String
  requirement   LegalRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([moduleKey])
}

model LegalEvidenceRequirement {
  id             String                   @id @default(uuid())
  evidenceName   String
  evidenceType   String
  mandatory      Boolean                  @default(true)
  frequency      LegalObligationFrequency @default(ANNUAL)
  retentionYears Int?
  createdAt      DateTime                 @default(now())
  requirementId  String
  requirement    LegalRequirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model LegalEvidenceLink {
  id                   String                  @id @default(uuid())
  entity               String
  entityId             String
  status               LegalRequirementStatus  @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  comments             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  companyRequirementId String
  companyRequirement   CompanyLegalRequirement @relation(fields: [companyRequirementId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
}

model LegalComplianceReview {
  id             String   @id @default(uuid())
  period         String
  score          Int      @default(0)
  status         String   @default("DRAFT")
  reviewedById   String?
  reportExportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, period])
}

enum Role {
  ADMIN
  SST
  EMPLOYEE
  AUDITOR
  SUPER_ADMIN
  /// Rol tecnico de plataforma: sin empresa, sin datos de tenants.
  DEVELOPER
}

