generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String
  role                   Role      @default(EMPLOYEE)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  companyId              String?
  isActive               Boolean   @default(true)
  deletedAt              DateTime?
  refreshTokenHash       String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  mfaSecret              String?
  mfaEnabled             Boolean   @default(false)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  ssoSubject             String?   @unique

  auditLogs                        AuditLog[]
  notifications                    Notification[]
  reportExports                    ReportExport[]
  approvedAnnualWorkPlans          AnnualWorkPlan[]             @relation("AnnualWorkPlanApprover")
  documentApprovals                DocumentApproval[]           @relation("DocumentApprovalApprover")
  ownedAnnualPlanActivities        AnnualPlanActivity[]         @relation("AnnualPlanActivityOwner")
  medicalSurveillanceProgramsOwned MedicalSurveillanceProgram[] @relation("MedicalSurveillanceOwner")
  plannedInspectionsAsInspector    PlannedInspection[]          @relation("PlannedInspectionInspector")
  unplannedInspectionsAsInspector  UnplannedInspection[]        @relation("UnplannedInspectionInspector")
  unsafeReportsAsReporter          UnsafeReport[]               @relation("UnsafeReportReporter")
  findingsOwned                    Finding[]                    @relation("FindingOwner")
  actionPlansOwned                 ActionPlan[]                 @relation("ActionPlanOwner")
  actionPlansVerified              ActionPlan[]                 @relation("ActionPlanVerifier")
  tasksOwned                       Task[]                       @relation("TaskOwner")
  taskComments                     TaskComment[]
  approvedChangeRequests           ChangeRequest[]              @relation("ChangeRequestApprover")
  company                          Company?                     @relation(fields: [companyId], references: [id])

  @@index([lockedUntil])
}

model Company {
  id                            String                       @id @default(uuid())
  name                          String
  nit                           String                       @unique
  address                       String?
  phone                         String?
  email                         String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  isActive                      Boolean                      @default(true)
  deletedAt                     DateTime?
  arl                           String?
  riskClass                     CompanyRiskClass             @default(CLASS_I)
  economicActivity              String?
  city                          String?
  department                    String?
  reportExportExpirationDays    Int?
  reportExportRetentionDays     Int?
  reportFailureRateAlertPercent Int?
  reportStorageAlertBytes       Int?
  whatsappAlertsEnabled         Boolean                      @default(false)
  whatsappAlertPhone            String?
  ssoProvider                   SsoProvider?
  audits                        Audit[]
  legalRequirements             CompanyLegalRequirement[]
  documents                     Document[]
  employees                     Employee[]
  externalDeliveries            ExternalDelivery[]
  incidents                     Incident[]
  indicators                    Indicator[]
  legalComplianceReviews        LegalComplianceReview[]
  notifications                 Notification[]
  reportExports                 ReportExport[]
  annualWorkPlans               AnnualWorkPlan[]
  plannedInspections            PlannedInspection[]
  unsafeReports                 UnsafeReport[]
  ppeItems                      PpeItem[]
  ppeDeliveries                 PpeDelivery[]
  medicalExams                  MedicalExam[]
  medicalRestrictions           MedicalRestriction[]
  medicalProfiles               MedicalProfile[]
  medicalSurveillancePrograms   MedicalSurveillanceProgram[]
  medicalCohorts                MedicalSurveillanceCohort[]
  pveDiagnoses                  PveDiagnosis[]
  pveCases                      PveCase[]
  auditPrograms                 AuditProgram[]
  sgsstEvaluations              SgsstEvaluation[]
  reportMetricSnapshots         ReportExportMetricSnapshot[]
  risks                         Risk[]
  riskProcesses                 RiskProcess[]
  sites                         Site[]
  trainings                     Training[]
  users                         User[]
  annualPlanActivities          AnnualPlanActivity[]
  unplannedInspections          UnplannedInspection[]
  contractors                   Contractor[]
  contractorWorkers             ContractorWorker[]
  contractorDocuments           ContractorDocument[]
  committees                    Committee[]
  committeeMembers              CommitteeMember[]
  committeeMeetings             CommitteeMeeting[]
  committeeCommitments          CommitteeCommitment[]
  emergencyBrigades             EmergencyBrigade[]
  emergencyBrigadeMembers       EmergencyBrigadeMember[]
  emergencyPlans                EmergencyPlan[]
  emergencyThreats              EmergencyThreat[]
  emergencyResources            EmergencyResource[]
  emergencyDrills               EmergencyDrill[]
  emergencyDrillFindings        EmergencyDrillFinding[]
  changeRequests                ChangeRequest[]
  findings                      Finding[]
  actionPlans                   ActionPlan[]
  tasks                         Task[]
}

model Site {
  id                   String                @id @default(uuid())
  name                 String
  code                 String?
  address              String?
  city                 String?
  department           String?
  isMain               Boolean               @default(false)
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  employees            Employee[]
  risks                Risk[]
  incidents            Incident[]
  trainings            Training[]
  documents            Document[]
  plannedInspections   PlannedInspection[]
  unplannedInspections UnplannedInspection[]
  unsafeReports        UnsafeReport[]
  indicators           Indicator[]
  emergencyBrigades    EmergencyBrigade[]
  emergencyPlans       EmergencyPlan[]
  contractorWorkers    ContractorWorker[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(true)
  deletedAt            DateTime?

  @@index([companyId, code])
  @@index([companyId, isActive])
}

model Employee {
  id                            String                      @id @default(uuid())
  firstName                     String
  lastName                      String
  document                      String                      @unique
  position                      String
  email                         String?
  phone                         String?
  createdAt                     DateTime                    @default(now())
  companyId                     String
  isActive                      Boolean                     @default(true)
  deletedAt                     DateTime?
  updatedAt                     DateTime                    @updatedAt
  documentType                  DocumentType                @default(CC)
  workCenter                    String?
  contractType                  ContractType                @default(INDEFINITE)
  employmentStatus              EmploymentStatus            @default(ACTIVE)
  hireDate                      DateTime?
  siteId                        String?
  company                       Company                     @relation(fields: [companyId], references: [id])
  site                          Site?                       @relation(fields: [siteId], references: [id])
  ppeDeliveries                 PpeDelivery[]
  medicalExams                  MedicalExam[]
  medicalRestrictions           MedicalRestriction[]
  surveillanceCohorts           MedicalSurveillanceCohort[]
  pveCases                      PveCase[]
  committeeMembers              CommitteeMember[]
  responsibleCommitments        CommitteeCommitment[]       @relation("CommitmentResponsible")
  emergencyBrigadeMemberships   EmergencyBrigadeMember[]
  emergencyPlanResponsibilities EmergencyPlan[]             @relation("EmergencyPlanResponsible")
  trainingAttendees             TrainingAttendee[]
}

// Gestion del cambio (S14): solicitud de cambio con evaluacion de riesgos
// obligatoria (link a Risk) y workflow con auditoria en cada paso:
// Solicitud -> Evaluacion -> Controles -> Aprobacion -> Implementacion ->
// Verificacion -> Cierre (#38, #39). Borrado: hard delete con traza (ADR).
model ChangeRequest {
  id                       String              @id @default(uuid())
  title                    String
  /// Motivo del cambio.
  reason                   String
  /// Proceso afectado.
  process                  String
  /// Responsable del cambio (texto libre del area solicitante).
  responsible              String
  requestedAt              DateTime            @default(now())
  // --- Evaluacion de riesgos (#38): obligatoria para avanzar del flujo ---
  hazards                  String?
  impacts                  String?
  controls                 String?
  /// Riesgo de la matriz GTC-45 asociado al cambio (obligatorio).
  riskId                   String?
  risk                     Risk?               @relation(fields: [riskId], references: [id])
  // --- Implementacion y verificacion (#39) ---
  implementationNotes      String?
  implementationEvidenceId String?
  implementationEvidence   Document?           @relation("ChangeRequestEvidence", fields: [implementationEvidenceId], references: [id], onDelete: SetNull)
  verificationNotes        String?
  approvedById             String?
  approvedBy               User?               @relation("ChangeRequestApprover", fields: [approvedById], references: [id])
  approvedAt               DateTime?
  status                   ChangeRequestStatus @default(REQUESTED)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([riskId])
}

// S14.2: etapas del workflow de gestion del cambio.
enum ChangeRequestStatus {
  REQUESTED
  EVALUATION
  CONTROLS
  APPROVAL
  IMPLEMENTATION
  VERIFICATION
  CLOSED
}

// Hallazgos unificados (S15.1, issue #40): punto unico de registro de no
// conformidades (NC), observaciones (OBS) y oportunidades de mejora (OM) con
// origen trazable (inspecciones, auditorias, reportes inseguros) o manual.
// Decision S15: coexisten con los hallazgos por modulo (sin migracion de datos).
model Finding {
  id          String            @id @default(uuid())
  title       String
  description String
  /// Origen del hallazgo; MANUAL no exige sourceId.
  sourceType  FindingSourceType @default(MANUAL)
  sourceId    String?
  type        FindingType       @default(NON_CONFORMITY)
  severity    FindingSeverity   @default(MINOR)
  status      FindingStatus     @default(OPEN)
  ownerId     String?
  owner       User?             @relation("FindingOwner", fields: [ownerId], references: [id])
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  causes      FindingCause[]

  @@index([companyId, status])
  @@index([sourceType, sourceId])
}

// Causas del hallazgo (S15.1): analisis de causa raiz antes de acciones (S15.2).
model FindingCause {
  id          String   @id @default(uuid())
  causeType   String
  description String
  createdAt   DateTime @default(now())
  findingId   String
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
}

// S15.1: origen trazable y tipo del hallazgo.
enum FindingSourceType {
  INSPECTION_PLANNED
  INSPECTION_UNPLANNED
  AUDIT
  UNSAFE_REPORT
  MANUAL
}

enum FindingType {
  NON_CONFORMITY
  OPPORTUNITY
  OBSERVATION
}

// Acciones correctivas/preventivas/mejora (S15.2, issue #41): plan de accion
// unificado del ciclo Actuar. Workflow: OPEN -> IN_PROGRESS -> DONE (con
// evidencia) -> VERIFIED (con sello de eficacia). CANCELLED solo desde
// OPEN/IN_PROGRESS. Reglas (#41): la CORRECTIVE exige causa raiz para
// verificarse; PREVENTIVE/IMPROVEMENT exigen beneficio esperado; en hallazgos
// CRITICAL el verificador no puede ser el responsable.
model ActionPlan {
  id              String              @id @default(uuid())
  title           String
  description     String
  kind            ActionKind          @default(CORRECTIVE)
  /// Causa raiz (obligatoria para verificar una CORRECTIVE).
  rootCause       String?
  /// Beneficio/resultado esperado (obligatorio para verificar
  /// PREVENTIVE/IMPROVEMENT, que no exigen no conformidad previa).
  expectedBenefit String?
  /// Resultado medido al verificar (opcional).
  result          String?
  ownerId         String?
  owner           User?               @relation("ActionPlanOwner", fields: [ownerId], references: [id])
  dueDate         DateTime
  status          ActionStatus        @default(OPEN)
  closedAt        DateTime?
  effectiveness   ActionEffectiveness @default(PENDING)
  /// Evidencia de ejecucion (requisito para pasar a DONE).
  evidenceId      String?
  evidence        Document?           @relation("ActionPlanEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  verifiedById    String?
  verifiedBy      User?               @relation("ActionPlanVerifier", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  /// Origen trazable: FINDING (hallazgo unificado S15.1) o null (sin origen).
  sourceType      String?
  sourceId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([sourceType, sourceId])
}

enum ActionKind {
  CORRECTIVE
  PREVENTIVE
  IMPROVEMENT
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

enum ActionEffectiveness {
  PENDING
  EFFECTIVE
  INEFFECTIVE
}

// Bandeja de tareas (S15.3, issue #42): seguimiento unificado del ciclo Actuar.
// Origen trazable (finding/action/change request); las tareas de hallazgos
// MAJOR/CRITICAL se generan automaticamente al crear el hallazgo.
enum TaskSourceType {
  FINDING
  ACTION_PLAN
  CHANGE_REQUEST
  MANUAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id              String           @id @default(uuid())
  title           String
  description     String?
  /// Origen trazable; MANUAL no exige sourceId.
  sourceType      TaskSourceType   @default(MANUAL)
  sourceId        String?
  /// Tarea derivada de hallazgo: severidad del hallazgo que la genero.
  findingSeverity FindingSeverity?
  ownerId         String?
  owner           User?            @relation("TaskOwner", fields: [ownerId], references: [id])
  dueDate         DateTime?
  priority        TaskPriority     @default(MEDIUM)
  status          TaskStatus       @default(OPEN)
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  comments        TaskComment[]

  @@index([companyId, status])
  @@index([ownerId, status])
  @@index([sourceType, sourceId])
}

model TaskComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Risk {
  id                  String                      @id @default(uuid())
  title               String
  description         String?
  level               RiskLevel
  createdAt           DateTime                    @default(now())
  companyId           String
  siteId              String?
  company             Company                     @relation(fields: [companyId], references: [id])
  site                Site?                       @relation(fields: [siteId], references: [id])
  inspectionFindings  InspectionFinding[]
  /// Cargo asociado (profesiograma S10.1): habilita la derivacion de
  /// requisitos medicos desde los riesgos del cargo (#25).
  position            String?
  profilesForRisk     MedicalProfile[]            @relation("MedicalProfileCargoRisk")
  cohortsForRisk      MedicalSurveillanceCohort[] @relation("MedicalSurveillanceCohortRisk")
  requirementsDerived MedicalExamRequirement[]    @relation("MedicalRequirementOrigin")
  changeRequests      ChangeRequest[]
  /// Peligro de la matriz GTC-45 estructurada (#57) del que este riesgo es el
  /// resultado final trazable (proceso → actividad → peligro → riesgo).
  hazardId            String?                     @unique
  hazard              RiskHazard?                 @relation("RiskHazardResult", fields: [hazardId], references: [id], onDelete: SetNull)

  @@index([companyId, position])
}

/// Matriz de riesgos GTC-45 estructurada (#57): jerarquía Proceso → Actividad →
/// Peligro → Valoración/Controles. El alcance multi-tenant vive en RiskProcess;
/// los hijos se acotan por la cadena de padres (patrón InspectionItem).
model RiskProcess {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  activities  RiskActivity[]

  @@index([companyId])
}

model RiskActivity {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  processId   String
  process     RiskProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  hazards     RiskHazard[]

  @@index([processId])
}

model RiskHazard {
  id          String           @id @default(uuid())
  name        String
  hazardType  HazardType       @default(FISICO)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  activityId  String           @unique
  activity    RiskActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  valorations RiskValoracion[]
  controls    HazardControl[]
  risk        Risk?            @relation("RiskHazardResult")

  @@index([activityId])
}

/// Valoración GTC-45: probabilidad × severidad → nivel I–IV (derivado en el
/// servicio; RiskLevel de Risk es el resultado final).
model RiskValoracion {
  id          String       @id @default(uuid())
  probability Int
  severity    Int
  riskLevel   RiskGtcLevel
  hazardId    String       @unique
  hazard      RiskHazard   @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([hazardId])
}

model HazardControl {
  id            String              @id @default(uuid())
  source        HazardControlSource
  type          String?
  effectiveness String?
  hazardId      String
  hazard        RiskHazard          @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())

  @@index([hazardId])
}

/// Numeral 3 de la GTC-45: clasificación del peligro generador.
enum HazardType {
  FISICO
  QUIMICO
  BIOLOGICO
  BIOMECANICO
  PSICOSOCIAL
  LOCATIVO
  TECNOLOGICO
  FENOMENOS_NATURALES
}

/// Numeral 5 de la GTC-45: fuente del control existente.
enum HazardControlSource {
  ADMINISTRATIVO
  OPERACIONAL
  COMPORTAMIENTO
  EPP
}

/// Nivel de resultado de la valoración GTC-45 (I trivial ... IV crítico).
enum RiskGtcLevel {
  I
  II
  III
  IV
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  description String
  date        DateTime
  status      IncidentStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  companyId   String
  siteId      String?
  company     Company        @relation(fields: [companyId], references: [id])
  site        Site?          @relation(fields: [siteId], references: [id])
}

// Capacitación (#58): se amplía con asistentes, evaluación, evidencia por
// trabajador y vencimiento del certificado (validityMonths → expiresAt por
// asistente cuando se marca PASSED).
model Training {
  id             String             @id @default(uuid())
  title          String
  description    String?
  date           DateTime
  createdAt      DateTime           @default(now())
  companyId      String
  siteId         String?
  company        Company            @relation(fields: [companyId], references: [id])
  site           Site?              @relation(fields: [siteId], references: [id])
  instructor     String?
  /// Meses de vigencia del certificado; define el vencimiento por asistente.
  validityMonths Int?
  attendees      TrainingAttendee[]
}

// Asistente de una capacitación (#58): evaluación (score/estado), evidencia
// documental por trabajador y vencimiento del certificado. employeeId es
// opcional para permitir asistentes externos por nombre; su borrado conserva
// el historial (SetNull). Scope multi-empresa via training.
model TrainingAttendee {
  id         String                 @id @default(uuid())
  trainingId String
  training   Training               @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Nombre congelado en la asistencia (vista/externo); obligatorio si no hay
  /// employeeId.
  name       String
  score      Float?
  status     TrainingAttendeeStatus @default(ATTENDED)
  expiresAt  DateTime?
  evidenceId String?
  evidence   Document?              @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime               @default(now())

  @@index([trainingId])
  @@index([employeeId])
  @@index([expiresAt])
}

/// Estado de la evaluación del asistente (numeral de evaluación de eficacia).
enum TrainingAttendeeStatus {
  ATTENDED
  PASSED
  FAILED
}

model Audit {
  id                String               @id @default(uuid())
  title             String
  description       String?
  scheduledAt       DateTime
  result            String?
  createdAt         DateTime             @default(now())
  companyId         String
  status            AuditStatus          @default(PLANNED)
  scope             String?
  auditorName       String?
  closedAt          DateTime?
  updatedAt         DateTime             @updatedAt
  programId         String?
  program           AuditProgram?        @relation(fields: [programId], references: [id])
  checklistTemplate Json?
  company           Company              @relation(fields: [companyId], references: [id])
  findings          AuditFinding[]
  checklist         AuditChecklistItem[]
}

model AuditProgram {
  id        String   @id @default(uuid())
  name      String
  period    String
  objective String?
  scope     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  audits    Audit[]
}

model AuditChecklistItem {
  id          String   @id @default(uuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  section     String?
  question    String
  answer      String?
  notes       String?
  responsible String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([auditId])
}

// Plan Anual de Trabajo SG-SST (S8.1): un plan por empresa y anio.
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model AnnualWorkPlan {
  id           String               @id @default(uuid())
  year         Int
  status       String               @default("DRAFT")
  notes        String?
  approvedById String?
  approvedBy   User?                @relation("AnnualWorkPlanApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  activities   AnnualPlanActivity[]

  @@unique([companyId, year])
  @@index([companyId, status])
}

// Actividad del Plan Anual de Trabajo (S8.2): responsable, fecha, evidencia
// documental y % de avance. La evidencia se integra con documents via FK.
model AnnualPlanActivity {
  id         String         @id @default(uuid())
  cycle      String         @default("ACT")
  name       String
  frequency  String?
  dueDate    DateTime?
  progress   Int            @default(0)
  status     String         @default("PENDING")
  budget     Float?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  planId     String
  plan       AnnualWorkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  ownerId    String?
  owner      User?          @relation("AnnualPlanActivityOwner", fields: [ownerId], references: [id])
  evidenceId String?
  evidence   Document?      @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([companyId, status])
}

// Contratistas (S11/S13): empresas contratistas, personal y documentos
// requeridos. Regla de negocio: no se autoriza ingreso con documentos
// vencidos/rechazados o contratista no activo (responsabilidad solidaria).
// S13.4: flujo de ingreso explícito VALIDATION -> INDUCTION -> AUTHORIZED ->
// WORK -> CLOSED con transiciones guardadas (entry-flow advance) y estado
// calculado en entry-authorization. Evidencia documental se integra con
// documents via FK (mismo patron de AnnualPlanActivity.evidence).
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model Contractor {
  id          String                @id @default(uuid())
  name        String
  nit         String
  contact     String?
  phone       String?
  arl         String?
  activity    String?
  status      ContractorStatus      @default(ACTIVE)
  entryStatus ContractorEntryStatus @default(VALIDATION)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id])
  workers     ContractorWorker[]
  documents   ContractorDocument[]

  @@unique([companyId, nit])
  @@index([companyId, status])
}

model ContractorWorker {
  id           String                 @id @default(uuid())
  document     String
  firstName    String
  lastName     String
  job          String?
  /// Sede donde el trabajador contratista ejecuta su actividad (#35):
  /// Contratista -> Trabajador -> Actividad -> Sede.
  siteId       String?
  site         Site?                  @relation(fields: [siteId], references: [id])
  inductedAt   DateTime?
  status       ContractorWorkerStatus @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contractorId String
  contractor   Contractor             @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company                @relation(fields: [companyId], references: [id])

  @@unique([contractorId, document])
  @@index([companyId])
  @@index([siteId])
}

model ContractorDocument {
  id           String                   @id @default(uuid())
  documentType String
  description  String?
  expiresAt    DateTime?
  status       ContractorDocumentStatus @default(PENDING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  contractorId String
  contractor   Contractor               @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  evidenceId   String?
  evidence     Document?                @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])

  @@index([contractorId])
  @@index([companyId, status])
}

enum ContractorStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ContractorWorkerStatus {
  ACTIVE
  INACTIVE
}

// S13.4: etapas del flujo de ingreso del contratista.
// Contratista -> Validacion -> Induccion -> Autorizacion -> Trabajo -> Cierre.
enum ContractorEntryStatus {
  VALIDATION
  INDUCTION
  AUTHORIZED
  WORK
  CLOSED
}

enum ContractorDocumentStatus {
  PENDING
  VALID
  EXPIRED
  REJECTED
}

// Inspecciones planeadas (S9.1): programacion por sede, checklist de items y
// hallazgos. Los hallazgos generan acciones correctivas (CorrectiveAction via
// InspectionFinding, mismo patron de Audit -> AuditFinding -> CorrectiveAction).
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model PlannedInspection {
  id                   String                @id @default(uuid())
  title                String
  type                 String                @default("LOCATIVE")
  frequency            String?
  scheduledAt          DateTime
  executedAt           DateTime?
  result               String?
  status               InspectionStatus      @default(PLANNED)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  siteId               String?
  site                 Site?                 @relation(fields: [siteId], references: [id])
  inspectorId          String?
  inspector            User?                 @relation("PlannedInspectionInspector", fields: [inspectorId], references: [id])
  items                InspectionItem[]
  findings             InspectionFinding[]
  unplannedInspections UnplannedInspection[]

  @@index([companyId, status])
  @@index([siteId])
}

// Item del checklist de la inspeccion (respuesta por pregunta).
model InspectionItem {
  id           String            @id @default(uuid())
  order        Int               @default(0)
  section      String?
  question     String
  answer       String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  inspectionId String
  inspection   PlannedInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// Hallazgo de inspeccion con enlace a CorrectiveAction (accion correctiva).
model InspectionFinding {
  id                    String               @id @default(uuid())
  description           String
  severity              FindingSeverity      @default(MINOR)
  status                FindingStatus        @default(OPEN)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Padre opcional: un hallazgo puede venir de una inspeccion planeada,
  // de una no planeada o de un reporte directo (S9.2/S9.3).
  inspectionId          String?
  inspection            PlannedInspection?   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  unplannedInspectionId String?
  unplannedInspection   UnplannedInspection? @relation(fields: [unplannedInspectionId], references: [id], onDelete: Cascade)
  riskId                String?
  risk                  Risk?                @relation(fields: [riskId], references: [id], onDelete: SetNull)
  actionId              String?              @unique
  action                CorrectiveAction?    @relation("InspectionFindingAction", fields: [actionId], references: [id], onDelete: SetNull)
  unsafeReport          UnsafeReport?        @relation(fields: [unsafeReportId], references: [id], onDelete: Cascade)
  unsafeReportId        String?

  @@index([inspectionId])
  @@index([unplannedInspectionId])
  @@index([unsafeReportId])
}

// Inspecciones no planeadas (S9.2): reactivas, con motivo obligatorio.
// Los hallazgos reutilizan InspectionFinding y pueden generar un riesgo en
// la matriz GTC-45 (Risk) ademas de la accion correctiva.
// Actos y condiciones inseguras (S9.3): canal de reporte directo con
// clasificacion (acto de comportamiento / condicion fisica), seguimiento y
// acciones via InspectionFinding (reporte directo, sin inspeccion padre).
// Reportes anonimos: reporterName opcional, nunca se expone al EMPLOYEE.
// Borrado: hard delete con traza en AuditLog (ADR de estrategia de borrado).
model UnsafeReport {
  id           String              @id @default(uuid())
  kind         String              @default("UNSAFE_CONDITION")
  description  String
  severity     FindingSeverity     @default(MINOR)
  status       String              @default("OPEN")
  area         String?
  isAnonymous  Boolean             @default(false)
  reporterName String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  closedAt     DateTime?
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  siteId       String?
  site         Site?               @relation(fields: [siteId], references: [id])
  reporterId   String?
  reporter     User?               @relation("UnsafeReportReporter", fields: [reporterId], references: [id])
  findings     InspectionFinding[]

  @@index([companyId, status])
  @@index([kind])
}

// Catalogo EPP (S9.4): tipo, talla/estandar, vida util y stock minimo.
model PpeItem {
  id             String        @id @default(uuid())
  name           String
  type           String?
  standard       String?
  size           String?
  usefulLifeDays Int?
  stockMin       Int           @default(0)
  stock          Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  deliveries     PpeDelivery[]

  @@index([companyId, isActive])
}

// Entrega de EPP a un trabajador: descuenta stock y programa reposicion.
model PpeDelivery {
  id               String    @id @default(uuid())
  quantity         Int       @default(1)
  deliveredAt      DateTime  @default(now())
  dueReplacementAt DateTime?
  signature        String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  itemId           String
  item             PpeItem   @relation(fields: [itemId], references: [id])
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])

  @@index([employeeId])
  @@index([itemId])
}

// Medicina laboral (S10): profesiograma (requisitos medicos por cargo),
// examenes ocupacionales y restricciones. Datos sensibles: acceso restringido
// a ADMIN/SST/AUDITOR (nunca EMPLOYEE) y solo concepto ocupacional, sin
// historia clinica. Auditoria completa en cada mutacion.

// Profesiograma: perfil medico por cargo con requisitos y periodicidad.
model MedicalProfile {
  id           String                   @id @default(uuid())
  position     String
  description  String?
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])
  requirements MedicalExamRequirement[]
  /// Link al riesgo del cargo en la matriz GTC-45 (#25.2).
  risk         Risk?                    @relation("MedicalProfileCargoRisk", fields: [riskId], references: [id], onDelete: SetNull)
  riskId       String?

  @@unique([companyId, position])
  @@index([companyId, riskId])
}

// Requisito medico del profesiograma: tipo de examen y periodicidad.
model MedicalExamRequirement {
  id                String         @id @default(uuid())
  examType          String
  periodicityMonths Int            @default(12)
  profileId         String
  profile           MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Origen de la derivacion (#25.2): riesgo que exige el examen. SetNull
  /// para que borrar el riesgo no borre el requisito ya aprobado.
  derivedFromRiskId String?
  derivedFromRisk   Risk?          @relation("MedicalRequirementOrigin", fields: [derivedFromRiskId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([derivedFromRiskId])
}

model MedicalSurveillanceProgram {
  id        String                      @id @default(uuid())
  name      String
  riskType  String
  objective String?
  status    String                      @default("ACTIVE")
  ownerId   String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  companyId String
  company   Company                     @relation(fields: [companyId], references: [id])
  owner     User?                       @relation("MedicalSurveillanceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  cohorts   MedicalSurveillanceCohort[]
  cases     PveCase[]

  @@index([companyId, status])
}

model MedicalSurveillanceCohort {
  id             String                     @id @default(uuid())
  programId      String
  program        MedicalSurveillanceProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  riskId         String?
  risk           Risk?                      @relation("MedicalSurveillanceCohortRisk", fields: [riskId], references: [id], onDelete: SetNull)
  derivedAt      DateTime                   @default(now())
  lastReviewedAt DateTime?
  status         String                     @default("ACTIVE")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  companyId      String
  company        Company                    @relation(fields: [companyId], references: [id])
  workers        Employee[]
  cases          PveCase[]

  @@unique([programId, riskId])
  @@index([companyId, status])
  @@index([riskId])
}

// Catalogo CIE-10 configurable por empresa (#44): los casos PVE referencian
// siempre un diagnostico del catalogo (sin codigos libres), para que el
// reporte y las tasas agrupen sobre datos normalizados.
model PveDiagnosis {
  id        String    @id @default(uuid())
  code      String
  name      String
  category  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  cases     PveCase[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

// Caso PVE por trabajador: diagnostico del catalogo, estado clínico
// (SUSPECTED/CONFIRMED/CLOSED), proximo control para alertas y dias de
// ausentismo reportados para la tasa sobre expuestos (#44).
model PveCase {
  id             String                     @id @default(uuid())
  status         String                     @default("SUSPECTED")
  reportedAt     DateTime                   @default(now())
  nextFollowUpAt DateTime?
  closedAt       DateTime?
  absenceDays    Int                        @default(0)
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  employeeId     String
  employee       Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  programId      String
  program        MedicalSurveillanceProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortId       String?
  cohort         MedicalSurveillanceCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  diagnosisId    String
  diagnosis      PveDiagnosis               @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)
  companyId      String
  company        Company                    @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([employeeId])
  @@index([programId])
  @@index([diagnosisId])
  @@index([nextFollowUpAt])
}

// Examen ocupacional de un trabajador: solo concepto operativo (APT0/RESTRICCION/
// NO_APTO), proveedor, proxima fecha; sin diagnostico ni historia clinica.
model MedicalExam {
  id           String               @id @default(uuid())
  examType     String
  concept      String               @default("PENDIENTE")
  scheduledAt  DateTime
  performedAt  DateTime?
  provider     String?
  nextDueAt    DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  restrictions MedicalRestriction[]

  @@index([employeeId])
  @@index([companyId, nextDueAt])
}

// Restriccion laboral derivada de un examen: vigencia y levantamiento.
model MedicalRestriction {
  id          String       @id @default(uuid())
  description String
  startDate   DateTime     @default(now())
  endDate     DateTime?
  liftedAt    DateTime?
  liftedBy    String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  examId      String?
  exam        MedicalExam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])

  @@index([employeeId, status])
}

model UnplannedInspection {
  id                  String              @id @default(uuid())
  title               String
  reason              String
  area                String?
  status              InspectionStatus    @default(PLANNED)
  executedAt          DateTime?
  result              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  siteId              String?
  site                Site?               @relation(fields: [siteId], references: [id])
  inspectorId         String?
  inspector           User?               @relation("UnplannedInspectionInspector", fields: [inspectorId], references: [id])
  findings            InspectionFinding[]
  plannedInspection   PlannedInspection?  @relation(fields: [plannedInspectionId], references: [id])
  plannedInspectionId String?

  @@index([companyId, status])
  @@index([siteId])
}

model SgsstEvaluation {
  id                String           @id @default(uuid())
  name              String
  standard          String           @default("RES_0312_2019")
  riskClass         String
  period            String?
  status            EvaluationStatus @default(IN_PROGRESS)
  score             Float?
  maxScore          Float?
  compliancePercent Float?
  notes             String?
  companyId         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id])
  items             EvaluationItem[]
}

model EvaluationItem {
  id           String               @id @default(uuid())
  evaluationId String
  evaluation   SgsstEvaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  numeral      String?
  section      String?
  question     String
  maxScore     Float                @default(0)
  score        Float?
  status       EvaluationItemStatus @default(PENDING)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([evaluationId])
}

model AuditFinding {
  id          String             @id @default(uuid())
  title       String
  description String?
  severity    FindingSeverity    @default(MINOR)
  status      FindingStatus      @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  auditId     String
  audit       Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actions     CorrectiveAction[]
}

model CorrectiveAction {
  id                  String                 @id @default(uuid())
  title               String
  description         String?
  responsible         String
  dueDate             DateTime
  status              CorrectiveActionStatus @default(PENDING)
  closedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  // Padre opcional: una accion nace de un hallazgo de auditoria (via
  // findingId) o de inspeccion/reporte (via inspectionFindingId, SetNull).
  // Nota: coexisten las columnas inspectionFindingId (escritura en creates de
  // S9) y InspectionFinding.actionId (lectura de idempotencia); ver
  // 20260925190000_s9_corrective_action_link.
  findingId           String?
  finding             AuditFinding?          @relation(fields: [findingId], references: [id], onDelete: Cascade)
  inspectionFindingId String?                @unique
  inspectionFinding   InspectionFinding?     @relation("InspectionFindingAction")
}

model Document {
  id                    String               @id @default(uuid())
  name                  String
  fileUrl               String
  createdAt             DateTime             @default(now())
  companyId             String
  description           String?
  category              DocumentCategory     @default(OTHER)
  status                DocumentStatus       @default(DRAFT)
  fileName              String?
  mimeType              String?
  version               Int                  @default(1)
  expiresAt             DateTime?
  updatedAt             DateTime             @updatedAt
  company               Company              @relation(fields: [companyId], references: [id])
  siteId                String?
  site                  Site?                @relation(fields: [siteId], references: [id])
  versions              DocumentVersion[]
  approvals             DocumentApproval[]
  annualPlanActivities  AnnualPlanActivity[]
  contractorDocuments   ContractorDocument[]
  committeeMinutes      CommitteeMeeting[]
  changeRequestEvidence ChangeRequest[]      @relation("ChangeRequestEvidence")
  actionPlanEvidence    ActionPlan[]         @relation("ActionPlanEvidence")
  trainingEvidence      TrainingAttendee[]
}

model DocumentVersion {
  id         String   @id @default(uuid())
  version    Int
  fileUrl    String
  fileName   String?
  mimeType   String?
  notes      String?
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentApproval {
  id         String                 @id @default(uuid())
  status     DocumentApprovalStatus @default(APPROVED)
  comments   String?
  approvedAt DateTime               @default(now())
  version    Int
  documentId String
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId String
  approver   User                   @relation("DocumentApprovalApprover", fields: [approverId], references: [id])

  @@unique([documentId, version])
  @@index([approverId])
}

model Indicator {
  id                String                 @id @default(uuid())
  name              String
  code              String?
  description       String?
  unit              String?
  value             Float
  formulaDefinition String?
  direction         String                 @default("LOWER_IS_BETTER")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  companyId         String
  siteId            String?
  company           Company                @relation(fields: [companyId], references: [id])
  site              Site?                  @relation(fields: [siteId], references: [id])
  targets           IndicatorTarget[]
  measurements      IndicatorMeasurement[]

  @@unique([companyId, code])
}

model IndicatorTarget {
  id          String    @id @default(uuid())
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      String
  target      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([indicatorId, period])
  @@index([indicatorId])
}

model IndicatorMeasurement {
  id          String    @id @default(uuid())
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      String
  value       Float
  measuredAt  DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([indicatorId, period])
  @@index([indicatorId])
}

model Notification {
  id                 String               @id @default(uuid())
  title              String
  message            String
  read               Boolean              @default(false)
  createdAt          DateTime             @default(now())
  userId             String
  type               NotificationType     @default(INFO)
  priority           NotificationPriority @default(MEDIUM)
  entity             String?
  entityId           String?
  readAt             DateTime?
  companyId          String?
  externalDeliveries ExternalDelivery[]
  company            Company?             @relation(fields: [companyId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
}

model ExternalDelivery {
  id             String                   @id @default(uuid())
  provider       ExternalDeliveryProvider
  status         ExternalDeliveryStatus   @default(PENDING)
  target         String?
  subject        String?
  payload        Json?
  response       Json?
  error          String?
  entity         String?
  entityId       String?
  attemptedAt    DateTime                 @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  companyId      String?
  notificationId String?
  attemptCount   Int                      @default(0)
  maxAttempts    Int                      @default(3)
  nextAttemptAt  DateTime?
  company        Company?                 @relation(fields: [companyId], references: [id])
  notification   Notification?            @relation(fields: [notificationId], references: [id])

  @@index([provider, status, attemptedAt])
  @@index([status, nextAttemptAt])
  @@index([companyId, attemptedAt])
  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
}

model ReportExport {
  id                 String             @id @default(uuid())
  kind               String
  format             String
  status             ReportExportStatus @default(QUEUED)
  requestedCompanyId String?
  fileUrl            String?
  fileName           String?
  mimeType           String?
  storageKey         String?
  size               Int?
  jobId              String?
  error              String?
  requestedAt        DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  requestedById      String
  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id])
  requestedBy        User               @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([companyId, createdAt])
  @@index([status, expiresAt])
}

model ReportExportMetricSnapshot {
  id                       String   @id @default(uuid())
  date                     DateTime
  scopeKey                 String
  total                    Int      @default(0)
  queued                   Int      @default(0)
  processing               Int      @default(0)
  ready                    Int      @default(0)
  failed                   Int      @default(0)
  expired                  Int      @default(0)
  storageBytes             Int      @default(0)
  averageGenerationSeconds Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  companyId                String?
  company                  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([date, scopeKey])
  @@index([companyId, date])
}

model LegalNorm {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  type          String
  issuingEntity String?
  issuedAt      DateTime?
  effectiveFrom DateTime?
  status        LegalNormStatus    @default(ACTIVE)
  url           String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  requirements  LegalRequirement[]
}

model LegalRequirement {
  id                   String                     @id @default(uuid())
  article              String?
  numeral              String?
  title                String
  description          String
  obligationType       String?
  frequency            LegalObligationFrequency   @default(ANNUAL)
  appliesTo            String?
  riskLevel            RiskLevel                  @default(MEDIUM)
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  normId               String
  companyRequirements  CompanyLegalRequirement[]
  evidenceRequirements LegalEvidenceRequirement[]
  norm                 LegalNorm                  @relation(fields: [normId], references: [id], onDelete: Cascade)
  mappings             LegalRequirementMapping[]

  @@index([normId])
  @@index([active, riskLevel])
}

model CompanyLegalRequirement {
  id             String                 @id @default(uuid())
  applies        Boolean                @default(true)
  status         LegalRequirementStatus @default(PENDING)
  ownerId        String?
  dueDate        DateTime?
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  score          Int?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  companyId      String
  requirementId  String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirement    LegalRequirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  evidences      LegalEvidenceLink[]

  @@unique([companyId, requirementId])
  @@index([companyId, status])
  @@index([dueDate])
}

model LegalRequirementMapping {
  id            String           @id @default(uuid())
  moduleKey     String
  entityName    String?
  entityId      String?
  evidenceType  String?
  kpiKey        String?
  reportKey     String?
  createdAt     DateTime         @default(now())
  requirementId String
  requirement   LegalRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([moduleKey])
}

model LegalEvidenceRequirement {
  id             String                   @id @default(uuid())
  evidenceName   String
  evidenceType   String
  mandatory      Boolean                  @default(true)
  frequency      LegalObligationFrequency @default(ANNUAL)
  retentionYears Int?
  createdAt      DateTime                 @default(now())
  requirementId  String
  requirement    LegalRequirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model LegalEvidenceLink {
  id                   String                  @id @default(uuid())
  entity               String
  entityId             String
  status               LegalRequirementStatus  @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  comments             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  companyRequirementId String
  companyRequirement   CompanyLegalRequirement @relation(fields: [companyRequirementId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
}

model LegalComplianceReview {
  id             String   @id @default(uuid())
  period         String
  score          Int      @default(0)
  status         String   @default("DRAFT")
  reviewedById   String?
  reportExportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, period])
}

